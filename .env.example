# Copy to .env (never commit .env) and fill in:
# Private key of an EVM wallet holding USDC on Base mainnet (each MCP tool call settles x402 micropayments).
RAEN_PAYER_KEY=0x...
# Required on the deployed gateway (streamable HTTP) — gate for /mcp since calls spend real money.
MCP_GATEWAY_KEY=change-me-long-random-string
# Local HTTP mode only (Fly injects PORT).
PORT=8080
